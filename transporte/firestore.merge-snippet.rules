// Cole SOMENTE este trecho dentro de:
// match /databases/{database}/documents { ... }
// das regras JÁ EXISTENTES de yoka-transporte.
// NÃO substitua o arquivo atual: o cadastro antigo de passageiros usa outras regras.

function transportSignedIn() {
  return request.auth != null;
}
function transportAdmin() {
  return transportSignedIn()
    && exists(/databases/$(database)/documents/transportAdmins/$(request.auth.uid))
    && get(/databases/$(database)/documents/transportAdmins/$(request.auth.uid)).data.active == true;
}
function transportTripOpen(tripId) {
  return exists(/databases/$(database)/documents/transportTrips/$(tripId))
    && get(/databases/$(database)/documents/transportTrips/$(tripId)).data.published == true
    && get(/databases/$(database)/documents/transportTrips/$(tripId)).data.status == 'open';
}
function validTransportResponse(d) {
  return d.keys().hasOnly(['guardian','phone','athletes','category','mode','quantity','manualVehicleId','ownerUid','createdAt','updatedAt'])
    && d.keys().hasAll(['guardian','phone','athletes','category','mode','quantity','ownerUid','createdAt','updatedAt'])
    && d.ownerUid == request.auth.uid
    && d.guardian is string && d.guardian.size() >= 2 && d.guardian.size() <= 100
    && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 20
    && d.athletes is string && d.athletes.size() >= 2 && d.athletes.size() <= 180
    && d.category is string && d.category.size() >= 1 && d.category.size() <= 25
    && d.mode in ['bus','car','no']
    && d.quantity is int
    && ((d.mode == 'bus' && d.quantity >= 1 && d.quantity <= 100)
      || (d.mode != 'bus' && d.quantity == 0))
    && (!('manualVehicleId' in d) || d.manualVehicleId == null
      || (d.manualVehicleId is string && d.manualVehicleId.size() <= 100));
}
match /transportAdmins/{uid} {
  allow get: if transportSignedIn() && request.auth.uid == uid;
  allow list, create, update, delete: if false;
}
match /transportTrips/{tripId} {
  allow get, list: if transportAdmin() || resource.data.published == true;
  allow create, update, delete: if transportAdmin();
  match /responses/{uid} {
    allow get: if transportAdmin() || (transportSignedIn() && request.auth.uid == uid);
    allow list: if transportAdmin();
    allow create: if transportAdmin()
      || (transportSignedIn() && request.auth.uid == uid
        && transportTripOpen(tripId)
        && !('manualVehicleId' in request.resource.data)
        && validTransportResponse(request.resource.data));
    allow update: if transportAdmin()
      || (transportSignedIn() && request.auth.uid == uid
        && resource.data.ownerUid == request.auth.uid
        && transportTripOpen(tripId)
        && validTransportResponse(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['guardian','phone','athletes','category','mode','quantity','updatedAt']));
    allow delete: if transportAdmin();
  }
}
